generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Album {
  id                 Int          @id @default(autoincrement())
  position           Int          @unique
  title              String
  artist             String
  releaseYear        Int?
  artworkUrl         String?
  artworkSource      String?
  musicBrainzId      String?      @unique
  tracklistReleaseId String?
  tracklistFetchedAt DateTime?
  tracks             AlbumTrack[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model AlbumTrack {
  id          Int    @id @default(autoincrement())
  albumId     Int
  discNumber  Int    @default(1)
  position    Int
  trackNumber String
  title       String
  lengthMs    Int?
  album       Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, discNumber, position])
  @@index([albumId])
}

model Film {
  id          Int      @id @default(autoincrement())
  position    Int      @unique
  title       String
  director    String?
  releaseYear Int?
  posterUrl   String?
  tmdbId      Int?     @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Song {
  id           Int      @id @default(autoincrement())
  position     Int      @unique
  title        String
  artist       String
  releaseYear  Int?
  artworkUrl   String?
  appleTrackId String?  @unique
  trackUrl     String?
  previewUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
