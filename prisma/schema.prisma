generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model User {
  id                 String     @id @default(cuid())
  name               String?
  email              String?    @unique
  emailVerified      DateTime?
  image              String?
  username           String?
  usernameKey        String?    @unique
  displayName        String?
  bio                String?    @db.VarChar(280)
  applicationMessage String?    @db.VarChar(500)
  isProfilePublic    Boolean    @default(false)
  isSiteOwner        Boolean    @default(false)
  role               UserRole   @default(USER)
  status             UserStatus @default(PENDING)
  approvedAt         DateTime?
  approvedById       String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  approvedBy    User?     @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[]    @relation("UserApprovals")
  accounts      Account[]
  sessions      Session[]
  albums        Album[]
  films         Film[]
  songs         Song[]
  invitationsCreated  Invitation[] @relation("InvitationCreator")
  invitationsAccepted Invitation[] @relation("InvitationAcceptor")

  @@index([approvedById])
  @@index([status])
  @@map("users")
}

model Invitation {
  id           String    @id @default(cuid())
  email        String
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String
  acceptedById String?

  createdBy  User  @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email, acceptedAt, revokedAt])
  @@index([expiresAt])
  @@index([createdById])
  @@index([acceptedById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Album {
  id                 Int          @id @default(autoincrement())
  ownerId            String
  position           Int
  title              String
  artist             String
  releaseYear        Int?
  artworkUrl         String?
  artworkSource      String?
  musicBrainzId      String?
  tracklistReleaseId String?
  tracklistFetchedAt DateTime?
  owner              User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tracks             AlbumTrack[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([ownerId, position])
  @@unique([ownerId, musicBrainzId])
}

model AlbumTrack {
  id          Int    @id @default(autoincrement())
  albumId     Int
  discNumber  Int    @default(1)
  position    Int
  trackNumber String
  title       String
  lengthMs    Int?
  album       Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, discNumber, position])
  @@index([albumId])
}

model Film {
  id          Int      @id @default(autoincrement())
  ownerId     String
  position    Int
  title       String
  director    String?
  releaseYear Int?
  posterUrl   String?
  tmdbId      Int?
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, position])
  @@unique([ownerId, tmdbId])
}

model Song {
  id           Int      @id @default(autoincrement())
  ownerId      String
  position     Int
  title        String
  artist       String
  releaseYear  Int?
  artworkUrl   String?
  appleTrackId String?
  trackUrl     String?
  previewUrl   String?
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerId, position])
  @@unique([ownerId, appleTrackId])
}
